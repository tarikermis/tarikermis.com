{
  "name": "tarikermis.com",
  "version": "1.0.0",
  "private": true,
  "description": "The personal site and selected work of software architect Tarik Ermis.",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
