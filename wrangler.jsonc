{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tarikermis",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "tarikermis.com",
      "custom_domain": true
    }
  ],
  "send_metrics": false
}
